{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fsantibanezleal/minephys/contracts/api-snapshot.schema.json",
  "title": "minephys public API snapshot",
  "description": "Public API snapshot docs/reference/api-snapshot.json written by tools/check_api.py --write at each release (DC-000-04, spec 000-foundation).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "objects"
  ],
  "properties": {
    "version": {
      "$ref": "#/$defs/release_version"
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/object"
      }
    }
  },
  "$defs": {
    "object": {
      "description": "One exported object; functions list their parameters in signature order.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "deprecated"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^minephys(\\.[A-Za-z_][A-Za-z0-9_]*){1,7}$"
        },
        "kind": {
          "enum": [
            "function",
            "class",
            "constant",
            "module"
          ]
        },
        "parameters": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "deprecated": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/deprecation"
            }
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "function"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "parameters"
        ]
      },
      "else": {
        "not": {
          "required": [
            "parameters"
          ]
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "default",
        "unit"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "kind": {
          "enum": [
            "positional_only",
            "positional_or_keyword",
            "var_positional",
            "keyword_only",
            "var_keyword"
          ]
        },
        "default": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "unit": {
          "description": "The docstring's bracketed unit without the brackets; null for flags and options.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "pattern": "^[^ \\t\\r\\n\\[\\]]([^\\r\\n\\[\\]]*[^ \\t\\r\\n\\[\\]])?$"
        }
      }
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "since",
        "removal",
        "replacement"
      ],
      "properties": {
        "since": {
          "$ref": "#/$defs/release_version"
        },
        "removal": {
          "$ref": "#/$defs/release_version"
        },
        "replacement": {
          "$ref": "#/$defs/text_line"
        }
      }
    },
    "release_version": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^[0-9]+\\.[0-9]{2}\\.[0-9]{3}$"
    },
    "text_line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^ \\t\\r\\n]([^\\r\\n]*[^ \\t\\r\\n])?$"
    }
  }
}
