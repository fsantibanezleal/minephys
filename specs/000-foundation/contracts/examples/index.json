  "not_schema_checkable": [
    {
      "schema": "knowledge-table.schema.json",
      "class": "row id duplicated within a table or across tables",
      "by": "checker",
      "rule": "FR-008-05"
    },
    {
      "schema": "knowledge-table.schema.json",
