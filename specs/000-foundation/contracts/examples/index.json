    },
    {
      "schema": "knowledge-table.schema.json",
      "class": "symbol not resolving to an exported object",
      "by": "checker",
      "rule": "FR-000-21"
    },
    {
      "schema": "knowledge-table.schema.json",
      "class": "verified row without a knowledge test marker",
      "by": "checker",
      "rule": "FR-000-21"
    },
    {
      "schema": "knowledge-table.schema.json",
      "class": "UNVERIFIED parameter row listed as a model-card default",
      "by": "checker",
      "rule": "FR-000-22"
    },
    {
      "schema": "knowledge-table.schema.json",
      "class": "range with min greater than max",
      "by": "checker",
      "rule": "FR-008-02"
    },
    {
      "schema": "knowledge-table.schema.json",
      "class": "calendar-invalid verified_on (for example 2026-02-30)",
      "by": "checker",
      "rule": "FR-000-20"
    },
    {
      "schema": "knowledge-table.schema.json",
      "class": "value, range or verification changed without a CHANGELOG entry",
      "by": "checker",
      "rule": "FR-000-30"
    },
    {
      "schema": "knowledge-table.schema.json",
      "class": "non-finite number (YAML .nan or .inf)",
      "by": "loader",
      "rule": "FR-008-02"
    },
    {
      "schema": "knowledge-table.schema.json",
      "class": "YAML anchor or alias, non-core tag, duplicate key, depth over 8, non-mapping top level, over 1 MiB or invalid UTF-8",
      "by": "loader",
      "rule": "FR-008-07"
    },
    {
      "schema": "bibliography-entry.schema.json",
      "class": "duplicate entry key",
      "by": "loader",
      "rule": "FR-008-08"
    },
    {
      "schema": "bibliography-entry.schema.json",
      "class": "field repeated within an entry",
      "by": "loader",
      "rule": "FR-008-08"
    },
    {
      "schema": "bibliography-entry.schema.json",
      "class": "unbalanced braces or quotes, @string, @preamble or @comment, file over 1 MiB",
      "by": "loader",
      "rule": "FR-008-08"
    },
    {
      "schema": "bibliography-entry.schema.json",
      "class": "share-alike source without its licence field",
      "by": "checker",
      "rule": "-",
      "note": "the licence field is the only share-alike marker of an entry; no file-level rule can detect its absence (review only)"
    },
    {
      "schema": "api-snapshot.schema.json",
      "class": "objects not sorted by name, or a name listed twice",
      "by": "checker",
      "rule": "FR-000-28"
    },
    {
      "schema": "api-snapshot.schema.json",
      "class": "parameters not in signature order, or a name that is not exported",
      "by": "checker",
      "rule": "FR-000-28"
    },
    {
      "schema": "api-snapshot.schema.json",
      "class": "deprecation removal version not later than its since version",
      "by": "checker",
      "rule": "FR-000-29"
    },
    {
      "schema": "api-snapshot.schema.json",
      "class": "duplicate JSON key or non-finite number in the snapshot file",
      "by": "loader",
      "rule": "-",
      "note": "no requirement names a strict JSON reader for tools/check_api.py"
    }
  ]
}
