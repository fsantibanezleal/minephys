{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fsantibanezleal/minephys/contracts/knowledge-table.schema.json",
  "title": "minephys knowledge table",
  "description": "One knowledge table file, src/minephys/knowledge/<table>.yaml or src/minephys/knowledge/share-alike/<table>.yaml (DC-000-02, spec 000-foundation).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "table",
    "title",
    "licence",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "table": {
      "$ref": "#/$defs/identifier"
    },
    "title": {
      "$ref": "#/$defs/text_line"
    },
    "licence": {
      "$ref": "#/$defs/table_licence"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "row": {
      "description": "One cited number: a value or a range with its units, role, citation, page, verification status and the exported symbols that read it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "quantity",
        "units",
        "role",
        "citation",
        "page",
        "verification",
        "symbol"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "quantity": {
          "$ref": "#/$defs/text_line"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/rational"
            }
          ]
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "units": {
          "$ref": "#/$defs/units"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "citation": {
          "$ref": "#/$defs/bib_key"
        },
        "page": {
          "$ref": "#/$defs/text_line"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "verified_on": {
          "$ref": "#/$defs/date"
        },
        "symbol": {
          "anyOf": [
            {
              "$ref": "#/$defs/dotted_symbol"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/dotted_symbol"
              }
            }
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "oneOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "range"
          ]
        }
      ],
      "if": {
        "properties": {
          "verification": {
            "const": "verified"
          }
        },
        "required": [
          "verification"
        ]
      },
      "then": {
        "required": [
          "verified_on"
        ]
      },
      "else": {
        "not": {
          "required": [
            "verified_on"
          ]
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "identifier": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "bib_key": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_:-]*$"
    },
    "rational": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^-?[0-9]+/[0-9]*[1-9][0-9]*$"
    },
    "text_line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^ \\t\\r\\n]([^\\r\\n]*[^ \\t\\r\\n])?$"
    },
    "units": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^ \\t\\r\\n]([^\\r\\n]*[^ \\t\\r\\n])?$",
      "not": {
        "enum": [
          "-",
          "none",
          "None",
          "dimensionless",
          "unitless",
          "n/a",
          "N/A"
        ]
      }
    },
    "verification": {
      "enum": [
        "verified",
        "UNVERIFIED"
      ]
    },
    "date": {
      "type": "string",
      "maxLength": 10,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "role": {
      "enum": [
        "model_constant",
        "parameter",
        "limit",
        "conversion"
      ]
    },
    "table_licence": {
      "enum": [
        "CC-BY-4.0",
        "CC-BY-SA-4.0",
        "CC-BY-SA-3.0"
      ]
    },
    "dotted_symbol": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^minephys\\.[a-z][a-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"
    }
  }
}
